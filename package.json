{
  "name": "myelin-1",
  "version": "0.1.0",
  "description": "LinkedIn and Indeed job-posting scrapers with a small SQLite store that reports only what is new.",
  "author": "Adhar",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx src/cli.ts scrape",
